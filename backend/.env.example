# KSLU Circle Backend Environment Variables
PORT=5000
NODE_ENV=development

# Database: Neon PostgreSQL connection strings
DATABASE_URL="postgresql://username:password@ep-sample-pool-123456.pooler.aws.neon.tech/kslu_circle?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample-direct-123456.aws.neon.tech/kslu_circle?sslmode=require"

# Authentication & Security
JWT_SECRET="kslu_circle_production_secure_jwt_secret_change_in_production_min_32_chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# File Storage (Cloudinary for Production, local for Development)
UPLOAD_STORAGE="local"
UPLOAD_DIR="./uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="kslu-circle"

# Email Configuration (Nodemailer for password resets and verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KSLU Circle <noreply@kslucircle.org>"

# Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Study Assistant (Gemini LLM API or compatible)
GEMINI_API_KEY=""
